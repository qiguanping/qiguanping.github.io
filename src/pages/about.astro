---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="关于 Albert" description="Albert's Tech Blog 关于页面">
  <section class="about-page shell">
    <p class="section-index">ABOUT</p>
    <div class="about-grid">
      <div>
        <p class="about-kicker">AI Infra · High-Performance Networking · RDMA</p>
        <h1>关于 Albert</h1>
      </div>
      <div class="about-copy">
        <p>
          我关注 AI 集群互联、高性能网络、RDMA、集合通信与推理基础设施，
          这个博客用于沉淀论文深读、机制分析和工程实践。
        </p>
        <div class="contact-block">
          <p class="about-kicker">联系方式</p>
          <a class="text-link" href="https://github.com/qiguanping" target="_blank" rel="noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>